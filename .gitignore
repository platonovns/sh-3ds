pc_port/tools/mdec_test_str.exe
# FMV rips (jpsxdec output) — large, regenerable from the disc, never commit
pc_port/tools/*.avi
# Extractor / runtime debug logs dumped into tools/
pc_port/tools/*.log
maperrs.txt
maprenames.txt

# Launcher (.NET) build artifacts — regenerated by Visual Studio
